<Application x:Class="DataBridge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels"
             xmlns:v="clr-namespace:DataBridge.App.Views"
             xmlns:infra="clr-namespace:DataBridge.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infra:BoolToVisibilityConverter x:Key="Visible" />
            <infra:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <infra:DepthToMarginConverter x:Key="DepthMargin" />
            <infra:EmptyToCollapsedConverter x:Key="NotEmpty" />

            <!-- Shell (2.0): home screen, then the backup or the restore wizard (same sidebar and footer) -->
            <DataTemplate DataType="{x:Type vm:ModeChoiceViewModel}"><v:ModeChoiceView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainViewModel}"><v:WizardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreViewModel}"><v:WizardView /></DataTemplate>

            <!-- Backup pages -->
            <DataTemplate DataType="{x:Type vm:BackupHubViewModel}"><v:SelectionHubView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DestinationViewModel}"><v:DestinationView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PersonalViewModel}"><v:PersonalView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdditionalViewModel}"><v:AdditionalView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OutlookViewModel}"><v:OutlookView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BrowsersViewModel}"><v:BrowsersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WifiViewModel}"><v:WifiView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkDrivesViewModel}"><v:NetworkDrivesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WallpaperViewModel}"><v:WallpaperView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrintersViewModel}"><v:PrintersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SummaryViewModel}"><v:SummaryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CopyViewModel}"><v:CopyView /></DataTemplate>

            <!-- Restore pages (2. Dossiers personnels reuses PersonalView) -->
            <DataTemplate DataType="{x:Type vm:RestoreSourceViewModel}"><v:RestoreSourceView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreHubViewModel}"><v:SelectionHubView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreAdditionalViewModel}"><v:RestoreAdditionalView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreOutlookViewModel}"><v:RestoreOutlookView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreBrowsersViewModel}"><v:RestoreBrowsersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreWifiViewModel}"><v:RestoreWifiView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreNetworkDrivesViewModel}"><v:RestoreNetworkDrivesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreWallpaperViewModel}"><v:RestoreWallpaperView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestorePrintersViewModel}"><v:RestorePrintersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreSummaryViewModel}"><v:RestoreSummaryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreProgressViewModel}"><v:RestoreProgressView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

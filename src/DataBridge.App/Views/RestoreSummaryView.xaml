<UserControl x:Class="DataBridge.App.Views.RestoreSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="LineTemplate" DataType="{x:Type vm:SummaryLine}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Mark" Width="16" Height="16" CornerRadius="4" Background="{StaticResource SuccessSoft}" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="MarkText" Style="{StaticResource Icon}" Text="{Binding Mark}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessAccent}" />
                        <Border x:Name="PartialDash" Width="8" Height="2" CornerRadius="1" Background="{StaticResource TextOnAccent}" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <TextBlock x:Name="Text" Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" HorizontalAlignment="Right" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{StaticResource SelectionAccent}" />
                    <Setter TargetName="MarkText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PartialDash" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOff}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{StaticResource SurfaceMuted}" />
                    <Setter TargetName="MarkText" Property="Foreground" Value="{StaticResource TextFaint}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextFaint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{StaticResource WarningSoft}" />
                    <Setter TargetName="MarkText" Property="Foreground" Value="{StaticResource WarningAccent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="Fig" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="FigLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,18">
            <TextBlock Text="Vérifier et lancer la restauration" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Vérifiez la sauvegarde source, la session de destination et chaque correspondance avant de lancer la restauration." />

            <!-- Blocking points -->
            <Border Style="{StaticResource DangerBanner}" Margin="0,12,0,0" Padding="16,12" Visibility="{Binding HasIssues, Converter={StaticResource Visible}}"
                    AutomationProperties.AutomationId="RestoreIssues">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" FontSize="17" Foreground="{StaticResource Danger}" VerticalAlignment="Top" Margin="0,1,12,0" />
                    <StackPanel>
                        <TextBlock Text="Points à corriger avant de lancer la restauration" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Source / destination -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Foreground="{StaticResource SelectionAccent}" Margin="0,0,7,0" />
                                    <TextBlock Text="SAUVEGARDE SOURCE" Style="{StaticResource Label}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"><Run Text="PC  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding SourceComputer, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                <TextBlock Margin="0,3,0,0"><Run Text="Utilisateur  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding SourceUser, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                <TextBlock Margin="0,3,0,0"><Run Text="Date  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding SourceDate, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                <TextBlock Margin="0,3,0,0"><Run Text="Version  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding SourceVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                <TextBlock Text="{Binding Generation}" Style="{StaticResource Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE977;" FontSize="12" Foreground="{StaticResource SelectionAccent}" Margin="0,0,7,0" />
                                        <TextBlock Text="PC DESTINATION" Style="{StaticResource Label}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0"><Run Text="PC  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding TargetComputer, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                    <TextBlock Margin="0,3,0,0"><Run Text="Session  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding TargetUser, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                    <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis"><Run Text="Profil  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding TargetProfile, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="CONTENU RESTAURÉ" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,4,0,0" AutomationProperties.AutomationId="RestoreSummaryGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SummaryGroup}">
                                        <StackPanel Margin="0,8,0,4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}" Margin="2,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Mappings -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="CORRESPONDANCES (SAUVEGARDE → DESTINATION)" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding Mappings}" Margin="0,6,0,0" AutomationProperties.AutomationId="RestoreMappings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MappingLine}">
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                                    <Border Style="{StaticResource CloudBadge}" Visibility="{Binding IsOneDrive, Converter={StaticResource Visible}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="10" Margin="0,0,4,0" />
                                                            <TextBlock Text="OneDrive" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Source}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                                <DockPanel Margin="0,1,0,0">
                                                    <TextBlock Text="→ " Foreground="{StaticResource SelectionAccent}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Destination}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" Margin="14,1,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Note, Converter={StaticResource NotEmpty}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column: figures, space, policy, warnings -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="{StaticResource BrandGradient}" CornerRadius="10,10,0,0" />
                            <StackPanel Margin="18">
                                <TextBlock Text="À RESTAURER" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding VolumeText}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="RestoreVolume" />
                                <TextBlock Text="{Binding AnalysisText}" Style="{StaticResource Small}" TextWrapping="Wrap"
                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                                        AutomationProperties.AutomationId="RestoreFigures">
                                    <Grid TextElement.FontSize="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Fichiers à restaurer" Style="{StaticResource FigLabel}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding FilesToRestoreText}" Style="{StaticResource Fig}" AutomationProperties.AutomationId="RestoreFilesToWrite" />
                                        <TextBlock Grid.Row="1" Text="  dont absents (nouveaux)" Style="{StaticResource FigLabel}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NewText}" Style="{StaticResource Fig}" />
                                        <TextBlock Grid.Row="2" Text="  dont remplacés" Style="{StaticResource FigLabel}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReplacedText}" Style="{StaticResource Fig}" AutomationProperties.AutomationId="RestoreReplaced" />
                                        <TextBlock Grid.Row="3" Text="Fichiers existants" Style="{StaticResource FigLabel}" FontWeight="SemiBold" Margin="0,8,0,2" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExistingText}" Style="{StaticResource Fig}" Margin="0,8,0,2" AutomationProperties.AutomationId="RestoreExisting" />
                                        <TextBlock Grid.Row="4" Text="  conservés" Style="{StaticResource FigLabel}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding KeptText}" Style="{StaticResource Fig}" />
                                        <TextBlock Grid.Row="5" Text="  déjà identiques" Style="{StaticResource FigLabel}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding IdenticalText}" Style="{StaticResource Fig}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding WifiText}" Style="{StaticResource Small}" Margin="0,8,0,0" Visibility="{Binding WifiText, Converter={StaticResource NotEmpty}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Space per volume -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ESPACE PAR VOLUME" Style="{StaticResource Label}" />
                            <TextBlock Text="Calculé après l'analyse." Style="{StaticResource Small}" Margin="0,6,0,0"
                                       Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,4,0,0" AutomationProperties.AutomationId="RestoreVolumes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VolumeLine}">
                                        <DockPanel Margin="0,4">
                                            <TextBlock x:Name="Mark" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource SuccessAccent}"
                                                       Margin="0,2,8,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Root}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Small}"><Run Text="{Binding Needed, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Free, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter TargetName="Mark" Property="Text" Value="&#xE783;" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource ErrorAccent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Conflict policy -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" AutomationProperties.AutomationId="ConflictPolicy">
                        <StackPanel>
                            <TextBlock Text="EN CAS DE FICHIER EXISTANT" Style="{StaticResource Label}" />
                            <RadioButton IsChecked="{Binding PolicyNewer, Mode=TwoWay}" GroupName="Policy" Margin="0,10,0,0" AutomationProperties.AutomationId="PolicyNewer">
                                <StackPanel>
                                    <TextBlock Text="Remplacer uniquement si la sauvegarde est plus récente" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Recommandé" Style="{StaticResource Small}" Foreground="{StaticResource TealText}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding PolicyKeep, Mode=TwoWay}" GroupName="Policy" Margin="0,8,0,0" AutomationProperties.AutomationId="PolicyKeep">
                                <TextBlock Text="Conserver les fichiers existants" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding PolicyReplace, Mode=TwoWay}" GroupName="Policy" Margin="0,8,0,0" AutomationProperties.AutomationId="PolicyReplace">
                                <TextBlock Text="Remplacer les fichiers existants" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </RadioButton>
                            <Border Background="{StaticResource InfoSoft}" BorderBrush="{StaticResource InfoBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding PolicyText}" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="PolicyText" />
                                    <TextBlock Text="{Binding PolicyNote}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Warnings -->
                    <Border Style="{StaticResource Banner}" Margin="0,12,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}"
                            AutomationProperties.AutomationId="RestoreWarnings">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource Warning}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{Binding BlockReason}" Style="{StaticResource Small}" Foreground="{StaticResource WarningAccent}" Margin="2,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding BlockReason, Converter={StaticResource NotEmpty}}" AutomationProperties.AutomationId="RestoreBlockReason" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

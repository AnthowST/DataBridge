<UserControl x:Class="DataBridge.App.Views.AdditionalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <DockPanel Margin="28,24,28,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="3. Fichiers et dossiers supplémentaires" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Ajoutez tout élément accessible par la session (autre partition, dossier de travail, fichier de configuration…). Ils seront copiés dans Additional\ avec leur chemin d'origine noté dans le journal." />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Command="{Binding AddFolderCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                        AutomationProperties.AutomationId="AddFolderButton" AutomationProperties.Name="Ajouter un dossier">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Ajouter un dossier" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddFilesCommand}" AutomationProperties.AutomationId="AddFilesButton" AutomationProperties.Name="Ajouter des fichiers">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="Ajouter des fichiers" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Margin="0,12,0,0" Visibility="{Binding Message, Converter={StaticResource NotEmpty}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SuccessBanner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorder}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="AdditionalMessage" />
            </Border>
        </StackPanel>

        <Grid Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" VerticalAlignment="Top" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" FontSize="28" Foreground="{StaticResource TextFaint}" />
                    <TextBlock Text="Aucun élément ajouté" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2" />
                    <TextBlock Text="Exemples : D:\Comptabilité, C:\Temp\config.xml, C:\Users\…\Projects" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}"
                          AutomationProperties.AutomationId="AdditionalList">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AdditionalItemViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12" AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding TypeLabel}" /></Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource PathText}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource Success}"
                                                   VerticalAlignment="Top" Margin="0,2,6,0" />
                                        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Success}"
                                                   MaxWidth="560" AutomationProperties.AutomationId="AdditionalStatus" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding CloudText, Converter={StaticResource NotEmpty}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="11" Foreground="{StaticResource Cloud}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding CloudText}" FontSize="12" Foreground="{StaticResource Cloud}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,16,0" />
                                <Button Grid.Column="3" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" VerticalAlignment="Top" Padding="10,4"
                                        AutomationProperties.AutomationId="RemoveButton" AutomationProperties.Name="{Binding Name, StringFormat='Retirer {0}'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Retirer" FontWeight="Normal" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                <Setter TargetName="StatusIcon" Property="Text" Value="&#xE946;" />
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                <Setter TargetName="StatusIcon" Property="Text" Value="&#xE946;" />
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Warning}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="StatusIcon" Property="Text" Value="&#xE783;" />
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Danger}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                <Setter TargetName="StatusIcon" Property="Text" Value="&#xE783;" />
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Danger}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Danger}" />
                                <Setter TargetName="StatusText" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</UserControl>

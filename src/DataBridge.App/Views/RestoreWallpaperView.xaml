<UserControl x:Class="DataBridge.App.Views.RestoreWallpaperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Fond d'écran de la session d'origine (fichier TranscodedWallpaper), restauré pour la session actuelle puis appliqué par Windows." />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding IsPresent, Converter={StaticResource Hidden}}"
                    AutomationProperties.AutomationId="WallpaperAbsent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Foreground="{StaticResource TextTertiary}" Margin="0,1,10,0" />
                    <TextBlock Text="Non présent dans cette sauvegarde." Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding IsPresent, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" AutomationProperties.AutomationId="RestoreWallpaper" AutomationProperties.Name="Fond d'écran">
                            <TextBlock Text="Fond d'écran" FontWeight="SemiBold" FontSize="14" />
                        </CheckBox>
                        <TextBlock Text="{Binding SizeText, StringFormat='TranscodedWallpaper · {0}'}" Foreground="{StaticResource TextMuted}" Margin="29,4,0,0" />
                        <TextBlock Text="SAUVEGARDE" Style="{StaticResource Label}" Margin="29,16,0,0" />
                        <TextBlock Text="{Binding SourceText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="29,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="DESTINATION" Style="{StaticResource Label}" Margin="29,14,0,0" />
                        <TextBlock Text="{Binding DestinationText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="29,4,0,0" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="WallpaperDestination" />
                        <TextBlock Text="{Binding ApplyText}" Style="{StaticResource Small}" Margin="29,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="288" Height="162" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Background="{StaticResource SurfaceAlt}" Margin="16,0,0,0" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Aperçu indisponible" Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0" Visibility="{Binding IsPresent, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="Le fond d'écran actuel est d'abord copié en sécurité. Si Windows ne l'actualise pas, le fichier reste restauré et l'écran final indique qu'il faut l'appliquer manuellement." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

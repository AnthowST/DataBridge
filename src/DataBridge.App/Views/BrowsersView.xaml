<UserControl x:Class="DataBridge.App.Views.BrowsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="RefreshBrowsersButton" AutomationProperties.Name="Actualiser">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Actualiser" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="5. Navigateurs" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Copie des profils Chrome, Edge et Firefox de la session (favoris, historique, extensions, paramètres). Les caches sont exclus." />
                </StackPanel>
            </DockPanel>

            <!-- Passwords warning (always visible) -->
            <Border Style="{StaticResource Banner}" Margin="0,16,0,0" AutomationProperties.AutomationId="PasswordWarning">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="16" Foreground="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,1,12,0" />
                    <StackPanel>
                        <TextBlock Text="Mots de passe enregistrés" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Les mots de passe enregistrés peuvent être protégés par Windows ou le navigateur et leur récupération n'est pas garantie par la copie du profil. Les mots de passe doivent être exportés manuellement avant la migration." />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Small}"
                                   Text="DataBridge ne lit, n'extrait et ne déchiffre jamais les mots de passe." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowserCardViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="40" Height="40" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="18" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <Border Style="{StaticResource TealBadge}" Visibility="{Binding Detected, Converter={StaticResource Visible}}">
                                                <TextBlock Text="Détecté" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Visibility="{Binding Detected, Converter={StaticResource Hidden}}">
                                                <TextBlock Text="Non détecté" />
                                            </Border>
                                            <Border Style="{StaticResource WarningBadge}" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                                <TextBlock Text="Ouvert" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DataRoot}" Style="{StaticResource PathText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <!-- Counters: fixed width and two lines always reserved (the size line keeps its place even when
                                         nothing is selected), so selecting a profile never changes the card's height or columns. -->
                                    <Grid Grid.Column="2" Width="230" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Small}" HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="BrowserSelectionText" />
                                        <TextBlock Grid.Row="1" Text="≈" FontWeight="SemiBold" Visibility="Hidden" />
                                        <TextBlock Grid.Row="1" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="BrowserSizeText" />
                                    </Grid>
                                </Grid>

                                <!-- Running warning -->
                                <Border Style="{StaticResource Banner}" Margin="0,12,0,0" Padding="10,8" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                        <TextBlock Text="{Binding RunningText}" TextWrapping="Wrap" FontSize="12.5" AutomationProperties.AutomationId="RunningWarning" />
                                    </DockPanel>
                                </Border>

                                <!-- Ambiguity / info -->
                                <Border Style="{StaticResource DangerBanner}" Margin="0,12,0,0" Padding="10,8" Visibility="{Binding Warning, Converter={StaticResource NotEmpty}}">
                                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12.5" />
                                </Border>

                                <!-- Profiles -->
                                <ItemsControl ItemsSource="{Binding Profiles}" Margin="50,8,0,0" Visibility="{Binding Detected, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BrowserProfileViewModel}">
                                            <!-- Profile row of fixed height: square, names and badge centred on the same horizontal axis. -->
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Height="32" VerticalContentAlignment="Center"
                                                      HorizontalAlignment="Left" AutomationProperties.Name="{Binding Folder}">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Folder, StringFormat='  ({0})'}" Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Account, StringFormat='  ·  {0}'}" Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" Visibility="{Binding Account, Converter={StaticResource NotEmpty}}" />
                                                    <Border Grid.Column="3" Style="{StaticResource AccentBadge}" VerticalAlignment="Center"
                                                            Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="Profil actif" />
                                                    </Border>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="50,6,0,0" Style="{StaticResource Small}" TextWrapping="Wrap"
                                           Visibility="{Binding Method, Converter={StaticResource NotEmpty}}">
                                    <Run Text="Détection : " /><Run Text="{Binding Method, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

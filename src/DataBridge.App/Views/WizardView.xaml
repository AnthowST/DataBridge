<UserControl x:Class="DataBridge.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <!-- Shared by the backup wizard (MainViewModel) and the restore wizard (RestoreViewModel): 4 steps on top, same footer. -->
    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= Steps -->
        <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="0,0,0,1" Padding="20,7,20,6">
            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.AutomationId="StepsBar" MaxWidth="760">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WizardStep}">
                        <Button Style="{StaticResource StepButton}" Command="{Binding GoCommand}" IsEnabled="{Binding CanGo}"
                                AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                            <StackPanel>
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="LeftLine" Height="2" VerticalAlignment="Center" Fill="{StaticResource BorderPrimary}" />
                                    <Rectangle x:Name="RightLine" Grid.Column="1" Height="2" VerticalAlignment="Center" Fill="{StaticResource BorderPrimary}" />
                                    <Border x:Name="Circle" Grid.ColumnSpan="2" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" HorizontalAlignment="Center"
                                            BorderBrush="{StaticResource BorderStrong}" Background="{StaticResource SurfacePrimary}">
                                        <Grid>
                                            <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock x:Name="Done" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessAccent}" Visibility="Hidden" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="StepTitle" Text="{Binding Title}" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="13"
                                           Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                <Setter TargetName="LeftLine" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                <Setter TargetName="RightLine" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Circle" Property="Background" Value="{StaticResource SuccessSoft}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
                                <Setter TargetName="LeftLine" Property="Fill" Value="{StaticResource SuccessBorder}" />
                                <Setter TargetName="RightLine" Property="Fill" Value="{StaticResource SuccessBorder}" />
                                <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Num" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Done" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Circle" Property="Background" Value="{StaticResource SelectionAccent}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource SelectionAccent}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource TextOnAccent}" />
                                <Setter TargetName="LeftLine" Property="Fill" Value="{StaticResource SuccessBorder}" />
                                <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource TextStrong}" />
                                <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ================================================= Page. "Personnaliser" pages are sub-pages of "Quoi": explicit way back on top. -->
        <DockPanel Grid.Row="1">
            <Border DockPanel.Dock="Top" Visibility="{Binding IsDetailPage, Converter={StaticResource Visible}}" Padding="15,8,24,0">
                <Button Style="{StaticResource GhostButton}" Command="{Binding BackToHubCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="BackToHubButton" AutomationProperties.Name="Retour à Quoi" ToolTip="Vos choix sont conservés">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,1,8,0" />
                        <TextBlock Text="Retour à Quoi" />
                    </StackPanel>
                </Button>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </DockPanel>

        <!-- ================================================= Footer -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="0,1,0,0"
                Padding="20,8" Visibility="{Binding ShowFooter, Converter={StaticResource Visible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Grid (not StackPanel): the destination takes the remaining width and is shortened with "…" -->
                <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="7" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding FooterSelection}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="FooterSelection" />
                    <Border Grid.Column="2" Style="{StaticResource CloudBadge}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding FooterCloud, Converter={StaticResource NotEmpty}}"
                            ToolTip="Fichiers sélectionnés mais disponibles uniquement en ligne : ils ne sont ni téléchargés ni comptés dans « À copier »."
                            AutomationProperties.AutomationId="FooterCloud" AutomationProperties.Name="{Binding FooterCloud}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="10" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding FooterCloud}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="3" Text="  ·  " Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding FooterDetail}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FooterDetail}" AutomationProperties.AutomationId="FooterDetail" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- A detailed page (opened from step 3) only has "Terminé", which brings back to step 3. -->
                    <Button Content="Précédent" Command="{Binding PreviousCommand}" Margin="0,0,10,0" MinWidth="104"
                            Visibility="{Binding IsDetailPage, Converter={StaticResource Hidden}}" AutomationProperties.AutomationId="PrevButton" />
                    <Button Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" MinWidth="104"
                            AutomationProperties.AutomationId="NextButton" AutomationProperties.Name="{Binding NextLabel}"
                            Visibility="{Binding IsSummaryPage, Converter={StaticResource Hidden}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NextLabel}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="9,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" MinWidth="104" Padding="18,8"
                            AutomationProperties.AutomationId="{Binding StartAutomationId}" AutomationProperties.Name="{Binding StartLabel}"
                            Visibility="{Binding IsSummaryPage, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding StartLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

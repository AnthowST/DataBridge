<UserControl x:Class="DataBridge.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <!-- Shared by the backup wizard (MainViewModel) and the restore wizard (RestoreViewModel): same sidebar, same footer. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= Sidebar + page -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="24,8,16,14">
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding ScanStatus, Converter={StaticResource NotEmpty}}" />
                        <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource TextTertiary}" AutomationProperties.AutomationId="VersionText" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StepsTitle}" Style="{StaticResource Label}" Margin="24,16,0,6" AutomationProperties.AutomationId="StepsTitle" />
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                             Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource NavContainer}"
                             AutomationProperties.AutomationId="NavList">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardPage}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Circle" Width="26" Height="26" CornerRadius="13" BorderThickness="1.5"
                                            BorderBrush="{StaticResource BorderStrong}" Background="{StaticResource SurfacePrimary}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Grid>
                                            <TextBlock x:Name="Num" Text="{Binding NumberText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12"
                                                       Foreground="{StaticResource TextTertiary}" Visibility="Collapsed" />
                                            <TextBlock x:Name="Done" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessAccent}" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasNumber}" Value="False">
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Circle" Property="Background" Value="{StaticResource SuccessSoft}" />
                                        <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Circle" Property="Background" Value="{StaticResource SelectionAccent}" />
                                        <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource SelectionAccent}" />
                                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource TextOnAccent}" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextOnAccent}" />
                                        <Setter TargetName="Done" Property="Foreground" Value="{StaticResource TextOnAccent}" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextStrong}" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>

        <!-- ================================================= Footer -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="0,1,0,0"
                Padding="22,11" Visibility="{Binding ShowFooter, Converter={StaticResource Visible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Grid (not StackPanel): the destination takes the remaining width and is shortened with "…" -->
                <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="7" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding FooterSelection}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="FooterSelection" />
                    <Border Grid.Column="2" Style="{StaticResource CloudBadge}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding FooterCloud, Converter={StaticResource NotEmpty}}"
                            ToolTip="Fichiers sélectionnés mais disponibles uniquement en ligne : ils ne sont ni téléchargés ni comptés dans « À copier »."
                            AutomationProperties.AutomationId="FooterCloud" AutomationProperties.Name="{Binding FooterCloud}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="10" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding FooterCloud}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="3" Text="  ·  " Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding FooterDetail}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FooterDetail}" AutomationProperties.AutomationId="FooterDetail" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Précédent" Command="{Binding PreviousCommand}" Margin="0,0,10,0" MinWidth="104"
                            AutomationProperties.AutomationId="PrevButton" />
                    <Button Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" MinWidth="104"
                            AutomationProperties.AutomationId="NextButton" AutomationProperties.Name="Suivant"
                            Visibility="{Binding IsSummaryPage, Converter={StaticResource Hidden}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Suivant" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="9,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" MinWidth="104" Padding="18,8"
                            AutomationProperties.AutomationId="{Binding StartAutomationId}" AutomationProperties.Name="{Binding StartLabel}"
                            Visibility="{Binding IsSummaryPage, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding StartLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="DataBridge.App.Views.RestoreOutlookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Signatures d'Outlook classique restaurées dans le dossier des signatures de cette session, et boîte aux lettres de la sauvegarde (PST) restaurée dans une boîte du profil Outlook de ce PC que vous choisissez." />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding IsPresent, Converter={StaticResource Hidden}}"
                    AutomationProperties.AutomationId="OutlookAbsent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Foreground="{StaticResource TextTertiary}" Margin="0,1,10,0" />
                    <TextBlock Text="Non présent dans cette sauvegarde." Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>

            <!-- Signatures -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasSignatures, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="RestoreSignatures" AutomationProperties.Name="Signatures Outlook" />
                        <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="4,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="17" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Signatures Outlook" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                    <Separator />
                    <Grid TextElement.FontSize="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sauvegarde" Foreground="{StaticResource TextTertiary}" Margin="0,3" />
                        <TextBlock Grid.Column="1" Text="{Binding SourceText}" FontFamily="{StaticResource MonoFont}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="Ancien dossier" Foreground="{StaticResource TextTertiary}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OriginalText}" FontFamily="{StaticResource MonoFont}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="Destination" Foreground="{StaticResource TextTertiary}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DestinationText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextStrong}" Margin="0,3" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SignaturesDestination" />
                    </Grid>
                    <TextBlock Text="SIGNATURES DE LA SAUVEGARDE" Style="{StaticResource Label}" Margin="0,14,0,0" />
                    <ItemsControl ItemsSource="{Binding Names}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Mailbox (2.1) -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasMailbox, Converter={StaticResource Visible}}">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource IconTile}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" FontSize="17" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"><Run Text="Boîte aux lettres sauvegardée : " /><Run Text="{Binding MailboxName, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{Binding MailboxContentText}" Foreground="{StaticResource TextMuted}" AutomationProperties.AutomationId="MailboxContent" />
                            <TextBlock Text="{Binding PstText}" Style="{StaticResource Small}" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </DockPanel>

                    <Separator />
                    <TextBlock Text="À RESTAURER (tout le contenu de chaque catégorie cochée)" Style="{StaticResource Label}" />
                    <UniformGrid Columns="4" Margin="0,6,0,0">
                        <CheckBox IsChecked="{Binding IncludeMails, Mode=TwoWay}" IsEnabled="{Binding CanMails}" Content="Mails" AutomationProperties.AutomationId="RestoreOutlookMails" />
                        <CheckBox IsChecked="{Binding IncludeCalendar, Mode=TwoWay}" IsEnabled="{Binding CanCalendar}" Content="Calendrier" AutomationProperties.AutomationId="RestoreOutlookCalendar" />
                        <CheckBox IsChecked="{Binding IncludeContacts, Mode=TwoWay}" IsEnabled="{Binding CanContacts}" Content="Contacts" AutomationProperties.AutomationId="RestoreOutlookContacts" />
                        <CheckBox IsChecked="{Binding IncludeAutocomplete, Mode=TwoWay}" IsEnabled="{Binding CanAutocomplete}" Content="Autocomplétion" AutomationProperties.AutomationId="RestoreOutlookAutocomplete" />
                    </UniformGrid>

                    <Separator />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ListStoresCommand}" VerticalAlignment="Top"
                                AutomationProperties.AutomationId="ListOutlookStoresButton" AutomationProperties.Name="Lister les boîtes Outlook">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Lister les boîtes Outlook" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="BOÎTE DE DESTINATION" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,4,0,0" AutomationProperties.AutomationId="OutlookTarget" />
                            <TextBlock Text="Les boîtes du profil Outlook de ce PC sont listées automatiquement (Outlook classique ouvert, boîte de destination configurée). Choisissez celle qui reçoit la sauvegarde : le choix est toujours explicite."
                                       Style="{StaticResource Small}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Banner}" Margin="0,10,0,0" Visibility="{Binding MailboxMessage, Converter={StaticResource NotEmpty}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Warning}" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding MailboxMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="RestoreMailboxMessage" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0" Visibility="{Binding StoresNote, Converter={StaticResource NotEmpty}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding StoresNote}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" AutomationProperties.AutomationId="RestoreStoresNote" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding StoreOptions}" Margin="0,6,0,0" AutomationProperties.AutomationId="TargetMailboxList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OutlookStoreOption}">
                                <RadioButton GroupName="RestoreMailbox" IsChecked="{Binding IsChosen, Mode=TwoWay}" Margin="0,4" AutomationProperties.Name="{Binding Label}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator />
                    <TextBlock Text="EMPLACEMENT" Style="{StaticResource Label}" />
                    <RadioButton IsChecked="{Binding MergeFolders, Mode=TwoWay}" GroupName="OutlookMode" Margin="0,8,0,0" AutomationProperties.AutomationId="OutlookMerge">
                        <StackPanel>
                            <TextBlock Text="Fusionner avec les dossiers existants" FontWeight="SemiBold" />
                            <TextBlock Text="Recommandé : Boîte de réception → Boîte de réception, Envoyés → Envoyés, Calendrier → Calendrier… même si les noms diffèrent." Style="{StaticResource Small}" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IntoNewFolder, Mode=TwoWay}" GroupName="OutlookMode" Margin="0,8,0,0" AutomationProperties.AutomationId="OutlookNewFolder">
                        <StackPanel>
                            <TextBlock Text="Placer dans un dossier « Restauration &lt;date&gt; »" FontWeight="SemiBold" />
                            <TextBlock Text="L'arborescence d'origine est recréée dans ce dossier." Style="{StaticResource Small}" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <CheckBox IsChecked="{Binding ReplaceAutocompleteCache, Mode=TwoWay}" IsEnabled="{Binding IncludeAutocomplete}" Margin="0,12,0,0"
                              AutomationProperties.AutomationId="OutlookReplaceCache">
                        <StackPanel>
                            <TextBlock Text="Remplacer aussi le cache d'autocomplétion de la boîte de destination" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Les adresses sont toujours ajoutées comme contacts (« Adresses autocomplétion »). Le remplacement du cache n'est pas garanti par Outlook ; l'ancien cache est d'abord copié."
                                       Style="{StaticResource Small}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0" Visibility="{Binding IsPresent, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="Boîte aux lettres : ajout uniquement, rien n'est supprimé ni modifié dans la boîte de destination, les éléments déjà présents ne sont pas recréés et aucun mail n'est envoyé. Une copie de travail du PST est utilisée (la sauvegarde n'est jamais ouverte directement). Les signatures cloud du nouvel Outlook ne sont pas concernées." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

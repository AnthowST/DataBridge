<UserControl x:Class="DataBridge.App.Views.OutlookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="4. Outlook" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Signatures d'Outlook classique (fichiers copiés dans Outlook\Signatures) et, si vous le souhaitez, une boîte aux lettres exportée dans un nouveau fichier PST (Outlook\Boite)." />

            <!-- Signatures -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" IsEnabled="{Binding Exists}" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="IncludeSignatures" AutomationProperties.Name="Signatures Outlook" />
                        <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="4,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="17" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Signatures Outlook" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextMuted}" AutomationProperties.AutomationId="SignatureCount" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <Separator />
                    <TextBlock Text="DOSSIER SOURCE" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <TextBlock Text="SIGNATURES DÉTECTÉES" Style="{StaticResource Label}" Visibility="{Binding Exists, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Names}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Mailbox (2.1). The checkbox is the main switch: unchecked, nothing below is shown and Outlook is not read. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IncludeMailbox, Mode=TwoWay}" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="IncludeMailbox" AutomationProperties.Name="Sauvegarder la boîte aux lettres" />
                        <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="4,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" FontSize="17" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Boîte aux lettres (PST)" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Cochée : la boîte choisie est exportée dans un nouveau PST (les boîtes du profil sont listées automatiquement, Outlook classique doit être ouvert)."
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Visibility="{Binding IncludeMailbox, Converter={StaticResource Visible}}" />
                            <TextBlock Text="Non sauvegardée : Outlook n'est pas lu, aucune boîte n'est exportée."
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Visibility="{Binding IncludeMailbox, Converter={StaticResource Hidden}}"
                                       AutomationProperties.AutomationId="MailboxExcluded" />
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center"
                                Visibility="{Binding IncludeMailbox, Converter={StaticResource Visible}}"
                                AutomationProperties.AutomationId="AnalyzeOutlookButton" AutomationProperties.Name="Analyser Outlook">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Analyser Outlook" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Visibility="{Binding IncludeMailbox, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource Banner}" Margin="0,12,0,0" Visibility="{Binding MailboxMessage, Converter={StaticResource NotEmpty}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Warning}" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding MailboxMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="MailboxMessage" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0" Visibility="{Binding StoresNote, Converter={StaticResource NotEmpty}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding StoresNote}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" AutomationProperties.AutomationId="StoresNote" />
                        </DockPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasStores, Converter={StaticResource Visible}}">
                        <Separator />
                        <TextBlock Text="BOÎTE À SAUVEGARDER" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{Binding StoreOptions}" Margin="0,4,0,0" AutomationProperties.AutomationId="MailboxList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OutlookStoreOption}">
                                    <RadioButton GroupName="BackupMailbox" IsChecked="{Binding IsChosen, Mode=TwoWay}" Margin="0,4" AutomationProperties.Name="{Binding Label}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator />
                        <TextBlock Text="CONTENU À SAUVEGARDER" Style="{StaticResource Label}" />
                        <TextBlock Text="Tout le contenu de chaque catégorie cochée est copié (aucun choix élément par élément). La boîte n'est que lue : rien n'y est déplacé, supprimé ni envoyé."
                                   Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <UniformGrid Columns="2">
                            <CheckBox IsChecked="{Binding IncludeMails, Mode=TwoWay}" Margin="0,4" AutomationProperties.AutomationId="OutlookMails" AutomationProperties.Name="Mails">
                                <StackPanel>
                                    <TextBlock Text="Mails" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MailsText}" Style="{StaticResource Small}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding IncludeCalendar, Mode=TwoWay}" Margin="0,4" AutomationProperties.AutomationId="OutlookCalendar" AutomationProperties.Name="Calendrier">
                                <StackPanel>
                                    <TextBlock Text="Calendrier" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CalendarText}" Style="{StaticResource Small}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding IncludeContacts, Mode=TwoWay}" Margin="0,4" AutomationProperties.AutomationId="OutlookContacts" AutomationProperties.Name="Contacts">
                                <StackPanel>
                                    <TextBlock Text="Contacts" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ContactsText}" Style="{StaticResource Small}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding IncludeAutocomplete, Mode=TwoWay}" Margin="0,4" AutomationProperties.AutomationId="OutlookAutocomplete" AutomationProperties.Name="Autocomplétion">
                                <StackPanel>
                                    <TextBlock Text="Autocomplétion" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AutocompleteText}" Style="{StaticResource Small}" />
                                </StackPanel>
                            </CheckBox>
                        </UniformGrid>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="Le PST est créé après la copie des fichiers, puis retiré du profil Outlook (le fichier reste dans la sauvegarde). Le fichier OST et le profil Outlook ne sont pas copiés. Le nouvel Outlook n'est pas pris en charge." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

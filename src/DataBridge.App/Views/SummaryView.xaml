<UserControl x:Class="DataBridge.App.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels"
             xmlns:copy="clr-namespace:DataBridge.Core.Copy;assembly=DataBridge.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="LineTemplate" DataType="{x:Type vm:SummaryLine}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Mark" Width="16" Height="16" CornerRadius="4" Background="{StaticResource SuccessSoft}" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="MarkText" Style="{StaticResource Icon}" Text="{Binding Mark}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessAccent}" />
                        <!-- Partial: white dash on blue, like the tri-state checkbox. -->
                        <Border x:Name="PartialDash" Width="8" Height="2" CornerRadius="1" Background="{StaticResource TextOnAccent}" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <TextBlock x:Name="Text" Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{StaticResource SelectionAccent}" />
                    <Setter TargetName="MarkText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PartialDash" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOff}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{StaticResource SurfaceMuted}" />
                    <Setter TargetName="MarkText" Property="Foreground" Value="{StaticResource TextFaint}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextFaint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{StaticResource WarningSoft}" />
                    <Setter TargetName="MarkText" Property="Foreground" Value="{StaticResource WarningAccent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,18">
            <TextBlock Text="Vérifier et lancer la sauvegarde" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Vérifiez la sélection. Les tailles correspondent exactement aux éléments cochés." />

            <!-- Destination inside a selected source: blocking -->
            <Border Style="{StaticResource DangerBanner}" Margin="0,12,0,0" Padding="16,12" Visibility="{Binding HasConflict, Converter={StaticResource Visible}}"
                    AutomationProperties.AutomationId="DestinationConflict">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" FontSize="18" Foreground="{StaticResource Danger}"
                               VerticalAlignment="Top" Margin="0,1,12,0" />
                    <StackPanel>
                        <TextBlock Text="{x:Static copy:DestinationConflict.Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Danger}"
                                   AutomationProperties.AutomationId="DestinationConflictTitle" />
                        <TextBlock Text="{x:Static copy:DestinationConflict.Message}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static copy:DestinationConflict.Advice}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConflictDetail}" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="DestinationConflictDetail" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Changer la destination" Command="{Binding ChooseDestinationCommand}" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="ConflictChangeDestination" />
                            <Button Content="Revenir à la sélection" Command="{Binding BackToSelectionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Left: source, destination, selection -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="12" Foreground="{StaticResource SelectionAccent}" Margin="0,0,7,0" />
                                    <TextBlock Text="SOURCE" Style="{StaticResource Label}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"><Run Text="PC  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding Machine, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                                <TextBlock Margin="0,3,0,0"><Run Text="Session  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding User, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /></TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{StaticResource SelectionAccent}" Margin="0,0,7,0" />
                                        <TextBlock Text="DESTINATION" Style="{StaticResource Label}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DestinationText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource TextStrong}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="SummaryDestination" />
                                    <Button Content="Changer la destination" Command="{Binding ChooseDestinationCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Padding="12,5" FontSize="12" AutomationProperties.AutomationId="SummaryChangeDestination" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="SÉLECTION" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,4,0,0" AutomationProperties.AutomationId="SummaryGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SummaryGroup}">
                                        <StackPanel Margin="0,8,0,4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}" Margin="2,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: what will really be copied, space, options -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                        <Border Height="3" VerticalAlignment="Top" Background="{StaticResource BrandGradient}" CornerRadius="10,10,0,0" />
                        <StackPanel Margin="18,18,18,18">
                            <TextBlock Text="À COPIER" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding PlannedBytesText}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="SummaryEstimated" />
                            <TextBlock Text="{Binding PlannedFilesText}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SummaryPlannedFiles" />

                            <!-- Selected = really copied + left online -->
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                    Padding="10,8" Margin="0,12,0,0" AutomationProperties.AutomationId="SummaryBreakdown">
                                <Grid TextElement.FontSize="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="Fichiers" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Taille" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right" Margin="14,0,0,0" />

                                    <TextBlock Grid.Row="1" Text="Sélectionnés" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFilesCell}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="SummarySelectedFiles" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedBytesCell}" HorizontalAlignment="Right" Margin="14,4,0,0" />

                                    <TextBlock Grid.Row="2" Text="À copier" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlannedFilesCell}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="SummaryPlannedCount" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PlannedBytesCell}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="14,4,0,0" />

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasCloudFiles, Converter={StaticResource Visible}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="11" Foreground="{StaticResource CloudAccent}" Margin="0,1,5,0" />
                                        <TextBlock Text="En ligne" Foreground="{StaticResource CloudAccent}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CloudFilesCell}" Foreground="{StaticResource CloudAccent}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                               Visibility="{Binding HasCloudFiles, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="SummaryCloudFiles" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CloudBytesCell}" Foreground="{StaticResource CloudAccent}" HorizontalAlignment="Right" Margin="14,4,0,0"
                                               Visibility="{Binding HasCloudFiles, Converter={StaticResource Visible}}" />
                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding CloudFateText}" FontStyle="Italic" Foreground="{StaticResource CloudAccent}"
                                               Margin="16,1,0,0" Visibility="{Binding HasCloudFiles, Converter={StaticResource Visible}}"
                                               AutomationProperties.AutomationId="SummaryCloudFate" />
                                </Grid>
                            </Border>

                            <Separator Margin="0,12" />
                            <TextBlock Text="ESPACE DISPONIBLE" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource Figure}" Margin="0,4,0,0" AutomationProperties.AutomationId="SummaryFree" />
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Insufficient space -->
                    <Border Style="{StaticResource DangerBanner}" Margin="0,12,0,0" Visibility="{Binding InsufficientSpace, Converter={StaticResource Visible}}"
                            AutomationProperties.AutomationId="InsufficientSpace">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource Danger}" Margin="0,0,8,0" />
                                <TextBlock Text="Espace insuffisant" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SpaceSelectedText}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SpaceFreeText}" />
                            <Button Content="Revenir à la sélection" Command="{Binding BackToSelectionCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    AutomationProperties.AutomationId="BackToSelectionButton" />
                        </StackPanel>
                    </Border>

                    <!-- Cloud-only files -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding HasCloudFiles, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" Foreground="{StaticResource CloudAccent}" Margin="0,0,8,0" />
                                <TextBlock Text="Fichiers OneDrive / cloud" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding CloudText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,8" TextWrapping="Wrap" />
                            <RadioButton IsChecked="{Binding SkipCloudOnly, Mode=TwoWay}" Margin="0,2" GroupName="Cloud" AutomationProperties.AutomationId="SkipCloudOnly">
                                <TextBlock TextWrapping="Wrap"><Run Text="Ne pas les télécharger" FontWeight="SemiBold" /><Run Text=" (recommandé, listés dans le journal)" Foreground="{StaticResource TextMuted}" /></TextBlock>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding DownloadCloudOnly, Mode=TwoWay}" Margin="0,4,0,0" GroupName="Cloud" AutomationProperties.AutomationId="DownloadCloudOnly">
                                <TextBlock Text="Les télécharger et les copier" TextWrapping="Wrap" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Warnings -->
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Banner}" Margin="0,0,0,8" Padding="10,8">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Why the (single) "Lancer la copie" button of the bottom bar is disabled -->
                    <Border Style="{StaticResource InfoBanner}" Padding="10,8" Visibility="{Binding BlockReason, Converter={StaticResource NotEmpty}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,2,8,0" />
                            <TextBlock Text="{Binding BlockReason}" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="BlockReason" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="DataBridge.App.Views.DataBridgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="500"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{StaticResource BackgroundPrimary}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Icon="/Assets/Branding/databridge-icon.ico">
    <Grid>
        <Border Height="3" VerticalAlignment="Top" Background="{StaticResource BrandGradient}" />
        <StackPanel Margin="26,26,26,22">
            <!-- Icon + heading -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="{Binding IconBackground}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding IconGlyph}" FontSize="19" Foreground="{Binding IconForeground}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"
                           VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="DialogHeading" />
            </Grid>

            <TextBlock Text="{Binding Intro}" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextSecondary}"
                       Visibility="{Binding Intro, Converter={StaticResource NotEmpty}}" />

            <!-- Items (e.g. the browsers that will be closed) -->
            <Border Margin="0,12,0,0" Padding="14,8" CornerRadius="8" Background="{StaticResource BackgroundTertiary}"
                    BorderBrush="{StaticResource BorderPrimary}" BorderThickness="1" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="DialogItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource SelectionAccent}" VerticalAlignment="Center" Margin="2,0,12,0" />
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" AutomationProperties.AutomationId="DialogItem" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Consequences (warning box) -->
            <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource WarningBorder}"
                    BorderThickness="1" Visibility="{Binding Warning, Converter={StaticResource NotEmpty}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource WarningAccent}"
                               VerticalAlignment="Top" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" LineHeight="19" AutomationProperties.AutomationId="DialogWarning" />
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding Detail}" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource Small}"
                       Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}" />

            <TextBlock Text="{Binding Question}" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"
                       Visibility="{Binding Question, Converter={StaticResource NotEmpty}}" AutomationProperties.AutomationId="DialogQuestion" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding SecondaryText}" MinWidth="104" Margin="0,0,10,0" Click="Secondary_Click" IsCancel="True"
                        Visibility="{Binding SecondaryText, Converter={StaticResource NotEmpty}}" AutomationProperties.AutomationId="DialogSecondary" />
                <Button x:Name="PrimaryButton" Content="{Binding PrimaryText}" MinWidth="150" Click="Primary_Click"
                        AutomationProperties.AutomationId="DialogPrimary" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="DataBridge.App.Views.DestinationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels"
             xmlns:copy="clr-namespace:DataBridge.Core.Copy;assembly=DataBridge.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="RefreshVolumesButton" AutomationProperties.Name="Actualiser les volumes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Actualiser" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Où enregistrer la sauvegarde ?" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Choisissez le support (clé USB, disque externe, autre partition, partage réseau) ou un dossier. La copie ne démarre jamais sans destination valide." />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="Volumes disponibles" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
            <ListBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume, Mode=TwoWay}"
                     Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CardContainer}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="VolumeList">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VolumeItem}">
                        <Grid Width="236" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Root}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,22,0">
                                <Border x:Name="Tile" Style="{StaticResource IconTile}" Width="40" Height="40" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Device}" />
                                    <TextBlock Margin="0,1,0,0">
                                        <Run Text="{Binding Root, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /><Run Text="   " /><Run Text="{Binding FileSystem, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="-6,10,0,0">
                                <Border x:Name="KindBadge" Style="{StaticResource Badge}"><TextBlock Text="{Binding KindLabel}" /></Border>
                                <Border Style="{StaticResource Badge}" Visibility="{Binding DeviceName, Converter={StaticResource NotEmpty}}" MaxWidth="150"
                                        ToolTip="{Binding DeviceName}">
                                    <TextBlock Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </WrapPanel>
                            <ProgressBar x:Name="Usage" Grid.Row="2" Style="{StaticResource UsageBar}" Margin="0,12,0,8" Maximum="1" Value="{Binding UsedRatio, Mode=OneWay}"
                                         ToolTip="{Binding UsedText}" />
                            <TextBlock Grid.Row="3" TextTrimming="CharacterEllipsis" ToolTip="{Binding UsedText}">
                                <Run Text="{Binding FreeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" /><Run Text=" " /><Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            </TextBlock>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                <Setter TargetName="KindBadge" Property="Style" Value="{StaticResource TealBadge}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                <Setter TargetName="KindBadge" Property="Style" Value="{StaticResource AccentBadge}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                <Setter TargetName="Usage" Property="Foreground" Value="{StaticResource WarningAccent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Command="{Binding ChooseFolderCommand}" HorizontalAlignment="Left" Margin="0,2,0,0"
                    AutomationProperties.AutomationId="ChooseFolderButton" AutomationProperties.Name="Choisir un autre dossier">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Choisir un autre dossier…" />
                </StackPanel>
            </Button>

            <!-- Selected destination -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasChoice, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="DOSSIER DE SAUVEGARDE QUI SERA CRÉÉ" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding FolderPreview}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,6,0,0"
                               TextWrapping="Wrap" AutomationProperties.AutomationId="BackupFolderPreview" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock FontSize="13" Margin="0,1,8,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                            <Setter Property="Text" Value="&#xE783;" />
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                            <Setter Property="Text" Value="&#xE72C;" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CheckText}" AutomationProperties.AutomationId="DestinationCheck" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- Backup folder inside a selected source: the copy cannot be launched -->
                    <Border Style="{StaticResource DangerBanner}" Margin="0,10,0,0" Visibility="{Binding HasConflict, Converter={StaticResource Visible}}"
                            AutomationProperties.AutomationId="DestinationConflictBanner">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" FontSize="15" Foreground="{StaticResource Danger}"
                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                            <StackPanel>
                                <TextBlock Text="{x:Static copy:DestinationConflict.Title}" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                                <TextBlock Text="{x:Static copy:DestinationConflict.Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{x:Static copy:DestinationConflict.Advice}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConflictDetail}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Banner}" Margin="0,0,0,6" Padding="10,7">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource Warning}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0" Visibility="{Binding HasChoice, Converter={StaticResource Hidden}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                    <TextBlock Text="Aucune destination choisie. Sélectionnez un volume ci-dessus ou un dossier." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

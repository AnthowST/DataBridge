<UserControl x:Class="DataBridge.App.Views.RestoreSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="InfoKey" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,18">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Choisissez le dossier racine d'une sauvegarde DataBridge (DataBridge_…, ou ProfileCopy_… des versions précédentes). Rien n'est restauré avant votre validation." />

            <!-- Choice -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ChooseCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="16,9"
                            AutomationProperties.AutomationId="ChooseBackupButton" AutomationProperties.Name="Choisir une sauvegarde DataBridge">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Choisir une sauvegarde DataBridge" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource IconTile}" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="18" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Dossier de la sauvegarde" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding SelectedPath, TargetNullValue='Aucun dossier sélectionné'}" Style="{StaticResource PathText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12" Margin="0,3,0,0" AutomationProperties.AutomationId="BackupPath" />
                        <TextBlock Text="Vérification de la sauvegarde…" Style="{StaticResource Small}" Margin="0,4,0,0"
                                   Visibility="{Binding IsChecking, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Not a backup / newer format -->
            <Border Style="{StaticResource DangerBanner}" Margin="0,10,0,0" Padding="16,12" Visibility="{Binding HasError, Converter={StaticResource Visible}}"
                    AutomationProperties.AutomationId="BackupError">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="15" Foreground="{StaticResource Danger}" Margin="0,1,10,0" />
                        <TextBlock Text="Sauvegarde non utilisable" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="25,4,0,0" AutomationProperties.AutomationId="BackupErrorText" />
                    <StackPanel Margin="25,10,0,0" Visibility="{Binding HasCandidates, Converter={StaticResource Visible}}">
                        <TextBlock Text="SAUVEGARDES TROUVÉES DANS CE DOSSIER" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupCandidate}">
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="8,4" Margin="-8,0,0,0"
                                            Command="{Binding DataContext.UseCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup information -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0" Visibility="{Binding HasContent, Converter={StaticResource Visible}}"
                    AutomationProperties.AutomationId="BackupInfo">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Background="{StaticResource BrandGradient}" CornerRadius="10,10,0,0" />
                    <StackPanel Margin="22,20,22,20">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" VerticalAlignment="Top" AutomationProperties.AutomationId="BackupGeneration">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TealBadge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLegacy}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource WarningAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding GenerationLabel}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14" Foreground="{StaticResource SuccessAccent}" Margin="0,1,8,0" />
                                <TextBlock Text="Sauvegarde DataBridge" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PC source" Style="{StaticResource InfoKey}" />
                            <TextBlock Grid.Column="1" Text="{Binding Computer}" Style="{StaticResource InfoValue}" AutomationProperties.AutomationId="BackupComputer" />
                            <TextBlock Grid.Column="2" Text="Session source" Style="{StaticResource InfoKey}" Margin="24,4,16,4" />
                            <TextBlock Grid.Column="3" Text="{Binding User}" Style="{StaticResource InfoValue}" AutomationProperties.AutomationId="BackupUser" />
                            <TextBlock Grid.Row="1" Text="Créée le" Style="{StaticResource InfoKey}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedText}" Style="{StaticResource InfoValue}" AutomationProperties.AutomationId="BackupDate" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Version" Style="{StaticResource InfoKey}" Margin="24,4,16,4" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding VersionText}" Style="{StaticResource InfoValue}" AutomationProperties.AutomationId="BackupVersion" />
                            <TextBlock Grid.Row="2" Text="Données" Style="{StaticResource InfoKey}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource InfoValue}" AutomationProperties.AutomationId="BackupSize" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Fichiers" Style="{StaticResource InfoKey}" Margin="24,4,16,4" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding FilesText}" Style="{StaticResource InfoValue}" AutomationProperties.AutomationId="BackupFiles" />
                            <TextBlock Grid.Row="3" Text="Profil source" Style="{StaticResource InfoKey}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SourceProfile}" Style="{StaticResource InfoValue}"
                                       FontFamily="{StaticResource MonoFont}" FontWeight="Normal" FontSize="12" />
                        </Grid>

                        <Separator Margin="0,14" />
                        <TextBlock Text="CATÉGORIES DÉTECTÉES" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,6,0,0" AutomationProperties.AutomationId="BackupCategories">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AccentBadge}" Margin="0,0,8,6" Padding="10,3,10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="10" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Remarks -->
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="12" Foreground="{StaticResource WarningAccent}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SecurityIssues}" Margin="0,8,0,0" Visibility="{Binding HasSecurityIssues, Converter={StaticResource Visible}}"
                                      AutomationProperties.AutomationId="BackupSecurity">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="12" Foreground="{StaticResource Danger}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding UseCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9"
                                    AutomationProperties.AutomationId="UseBackupButton" AutomationProperties.Name="Utiliser cette sauvegarde">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Utiliser cette sauvegarde" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="9,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Border Style="{StaticResource SuccessBadge}" Margin="12,0,0,0" Visibility="{Binding IsInUse, Converter={StaticResource Visible}}">
                                <TextBlock Text="Sauvegarde utilisée pour la restauration" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="La restauration se fait toujours vers la session Windows actuelle : les dossiers personnels vont dans les dossiers personnels de cette session (Bureau, Documents… y compris s'ils sont redirigés vers OneDrive), jamais vers les anciens chemins. La sauvegarde n'est pas modifiée." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

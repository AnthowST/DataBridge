<UserControl x:Class="DataBridge.App.Views.RestoreAdditionalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Fichiers et dossiers ajoutés manuellement lors de la sauvegarde. DataBridge propose leur emplacement d'origine quand il est toujours valide sur ce PC ; sinon, choisissez une destination." />

            <!-- Absent from the backup -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding IsPresent, Converter={StaticResource Hidden}}"
                    AutomationProperties.AutomationId="AdditionalAbsent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Foreground="{StaticResource TextTertiary}" Margin="0,1,10,0" />
                    <TextBlock Text="Non présent dans cette sauvegarde." Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}" Margin="0,18,0,0" AutomationProperties.AutomationId="AdditionalItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RestoreAdditionalItemViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,9,0,0"
                                          AutomationProperties.AutomationId="AdditionalCheck" AutomationProperties.Name="{Binding Name}" />
                                <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="4,0,12,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" />
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Small}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Fixed rows: source, original path, destination (no layout shift when checking) -->
                                    <Grid Margin="0,8,0,0" TextElement.FontSize="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Sauvegarde" Foreground="{StaticResource TextTertiary}" Margin="0,2" />
                                        <TextBlock Grid.Column="1" Text="{Binding SourceText}" FontFamily="{StaticResource MonoFont}" Margin="0,2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="Ancien chemin" Foreground="{StaticResource TextTertiary}" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OriginalText}" FontFamily="{StaticResource MonoFont}" Margin="0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalText}" />
                                        <TextBlock Grid.Row="2" Text="Destination" Foreground="{StaticResource TextTertiary}" Margin="0,2" />
                                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2" LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Margin="10,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource TealBadge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDestination}" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource WarningAccent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding KindLabel}" />
                                            </Border>
                                            <TextBlock Text="{Binding DestinationText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DestinationText}"
                                                       AutomationProperties.AutomationId="AdditionalDestination">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDestination}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningAccent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Small}" Margin="0,2" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Padding="12,6" FontSize="12" AutomationProperties.AutomationId="AdditionalChoose"
                                            AutomationProperties.Name="Choisir une autre destination">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,7,0" Foreground="{StaticResource SelectionAccent}" />
                                            <TextBlock Text="Choisir une autre destination" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Style="{StaticResource GhostButton}" Content="Revenir à la proposition" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right"
                                            Visibility="{Binding IsCustom, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource InfoBanner}" Margin="0,2,0,0" Visibility="{Binding IsPresent, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="Un élément sans destination fiable n'est jamais restauré à l'aveugle : choisissez une destination ou décochez-le. Un ancien chemin situé dans le profil d'origine est adapté au profil de cette session." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

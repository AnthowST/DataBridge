<UserControl x:Class="DataBridge.App.Views.NetworkDrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}" Content="Tout cocher" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Tout décocher" Command="{Binding SelectNoneCommand}" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshNetworkDrivesButton"
                            AutomationProperties.Name="Actualiser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Actualiser" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Lecteurs réseau" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Lecteurs réseau de la session : lettre, chemin du partage et compte utilisé. Ils sont enregistrés dans la sauvegarde puis reconnectés à la restauration." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="Le mot de passe d'un lecteur réseau n'est pas lisible (Windows le garde dans le Gestionnaire d'identification) : il n'est pas sauvegardé. À la restauration, si le partage le demande, Windows affiche sa propre fenêtre de connexion avec le compte déjà rempli." />
                </DockPanel>
            </Border>

            <!-- Loading / nothing to show -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding IsLoaded, Converter={StaticResource Hidden}}">
                <TextBlock Text="Détection des lecteurs réseau…" Foreground="{StaticResource TextMuted}" />
            </Border>
            <Border Style="{StaticResource Banner}" Margin="0,10,0,0" Visibility="{Binding Message, Converter={StaticResource NotEmpty}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Warning}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="NetworkDrivesMessage" />
                </DockPanel>
            </Border>

            <Border Margin="0,10,0,0" Padding="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="NetworkDrivesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NetworkDriveItemViewModel}">
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Letter}"
                                              AutomationProperties.AutomationId="NetworkDriveCheck" />
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8CE;" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding RemotePath}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Small}" Margin="22,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE77B;" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Account}" FontSize="12" Foreground="{StaticResource TextMuted}" AutomationProperties.AutomationId="NetworkDriveAccount" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

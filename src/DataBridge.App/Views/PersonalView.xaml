<UserControl x:Class="DataBridge.App.Views.PersonalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels"
             xmlns:v="clr-namespace:DataBridge.App.Views">
    <UserControl.Resources>
        <!-- Text of an excluded row is dimmed so the selection state reads at a glance. -->
        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Personal folder name: navy, dimmed by the RowName triggers when excluded (style setter, not a local value). -->
        <Style x:Key="RootName" TargetType="TextBlock" BasedOn="{StaticResource RowName}">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        </Style>
        <Style x:Key="SizeCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLarge}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Cocher la sélection" Command="{Binding CheckItemsCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Décocher la sélection" Command="{Binding UncheckItemsCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- Root row: one personal Known Folder -->
        <DataTemplate x:Key="RootRow" DataType="{x:Type vm:TreeRowViewModel}">
            <Grid Height="62" Margin="2,0,6,0" AutomationProperties.Name="{Binding Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              Visibility="{Binding HasChildren, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="RowExpander"
                              AutomationProperties.Name="{Binding Name, StringFormat='Ouvrir {0}'}" />
                <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Focusable="False"
                          AutomationProperties.AutomationId="RowCheck" AutomationProperties.Name="{Binding Name}" />
                <Border Grid.Column="2" Style="{StaticResource IconTile}" Width="36" Height="36" VerticalAlignment="Center" Margin="2,0,12,0">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Root.Glyph}" FontSize="17" />
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Style="{StaticResource RootName}" />
                        <Border Style="{StaticResource TealBadge}" Visibility="{Binding Root.IsOneDrive, Converter={StaticResource Hidden}}">
                            <TextBlock Text="{Binding Root.LocationLabel}" />
                        </Border>
                        <!-- OneDrive: account title in the badge, e-mail (or "Compte non identifié") right after it -->
                        <Border Style="{StaticResource CloudBadge}" Visibility="{Binding Root.IsOneDrive, Converter={StaticResource Visible}}"
                                ToolTip="{Binding Root.OneDriveTooltip}" AutomationProperties.AutomationId="RootOneDrive"
                                AutomationProperties.Name="{Binding Root.OneDriveTitle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="11" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Root.OneDriveTitle}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Root.OneDriveDetail}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Root.OneDriveTooltip}" AutomationProperties.AutomationId="RootOneDriveAccount">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="Visibility" Value="{Binding Root.IsOneDrive, Converter={StaticResource Visible}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Root.OneDriveDetail}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Root.OneDriveUnidentified}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Root.PathLine}" ToolTip="{Binding Root.PathTooltip}" Style="{StaticResource PathText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5" Margin="0,2,0,0" AutomationProperties.AutomationId="RootPath" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11.5" Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
                </StackPanel>
                <!-- Size on this PC, cloud-only part apart, then count and selection state -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,4,0" MinWidth="200"
                            AutomationProperties.AutomationId="RootSizes" AutomationProperties.Name="{Binding Root.TotalText}">
                    <TextBlock Text="{Binding Root.TotalText}" FontWeight="SemiBold" HorizontalAlignment="Right" AutomationProperties.AutomationId="RootLocal" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding Root.CloudText, Converter={StaticResource NotEmpty}}"
                                ToolTip="{Binding Root.CloudTooltip}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="11" Foreground="{StaticResource Cloud}" Margin="0,1,4,0" />
                        <TextBlock Text="{Binding Root.CloudText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Cloud}"
                                   AutomationProperties.AutomationId="RootCloud" />
                    </StackPanel>
                    <TextBlock Text="{Binding Root.DetailText}" Style="{StaticResource Small}" HorizontalAlignment="Right" AutomationProperties.AutomationId="RootDetail" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Folder / file row -->
        <DataTemplate x:Key="EntryRow" DataType="{x:Type vm:TreeRowViewModel}">
            <Grid Height="30" Margin="2,0,6,0" AutomationProperties.Name="{Binding Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="{Binding Depth, Converter={StaticResource DepthMargin}}" LastChildFill="True">
                    <Grid Width="24" DockPanel.Dock="Left">
                        <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding HasChildren, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="RowExpander"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Ouvrir {0}'}" />
                    </Grid>
                    <CheckBox DockPanel.Dock="Left" Width="26" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Focusable="False"
                              AutomationProperties.AutomationId="RowCheck" AutomationProperties.Name="{Binding Name}" />
                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Border Style="{StaticResource WarningBadge}" Visibility="{Binding IsLarge, Converter={StaticResource Visible}}"
                                ToolTip="Fichier volumineux (1 Go ou plus). Ce n'est pas une erreur : décochez-le s'il n'est pas utile.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock Text="Volumineux" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CloudBadge}" Visibility="{Binding IsCloudOnly, Converter={StaticResource Visible}}"
                                ToolTip="Fichier OneDrive / cloud non présent sur le disque : il serait téléchargé pour être copié.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock Text="Disponible uniquement en ligne" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CloudBadge}" Visibility="{Binding CloudFilesText, Converter={StaticResource NotEmpty}}"
                                ToolTip="{Binding CloudFilesTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding CloudFilesText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AccentBadge}" Visibility="{Binding IsBoundary, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding BoundaryLabel, StringFormat='Géré dans {0}'}" />
                        </Border>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11.5" Margin="6,0,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" ToolTip="{Binding FullPath}" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding Modified}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource SizeCell}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ExplorerRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource RowContainer}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>

        <v:RowTemplateSelector x:Key="RowSelector" RootTemplate="{StaticResource RootRow}" EntryTemplate="{StaticResource EntryRow}" />
    </UserControl.Resources>

    <DockPanel Margin="24,14,24,12">
        <!-- Title -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Content="Tout cocher" Command="{Binding SelectAllCommand}" AutomationProperties.AutomationId="SelectAllButton" />
                <Button Style="{StaticResource GhostButton}" Content="Tout décocher" Command="{Binding SelectNoneCommand}" AutomationProperties.AutomationId="SelectNoneButton" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" ToolTip="Relire les dossiers et recalculer les tailles"
                        AutomationProperties.Name="Actualiser">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Restore: destinations synchronized by OneDrive (information only, never blocking) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,12,0,0" Padding="12,8"
                Visibility="{Binding ShowOneDriveNotice, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="OneDriveRestoreNotice">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" Foreground="{StaticResource Cloud}" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12.5"
                           Text="Les fichiers restaurés dans ce dossier seront ensuite synchronisés par OneDrive." />
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Rechercher : .iso, .zip, nom de fichier…" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Rechercher" />
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                <Button Style="{StaticResource ChipButton}" Content=".iso" Command="{Binding QuickSearchCommand}" CommandParameter=".iso" />
                <Button Style="{StaticResource ChipButton}" Content=".zip" Command="{Binding QuickSearchCommand}" CommandParameter=".zip" />
                <Button Style="{StaticResource ChipButton}" Content=".pst" Command="{Binding QuickSearchCommand}" CommandParameter=".pst" />
                <Button Style="{StaticResource ChipButton}" Content=".vhdx" Command="{Binding QuickSearchCommand}" CommandParameter=".vhdx" />
                <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding LargeOnly, Mode=TwoWay}" AutomationProperties.AutomationId="LargeOnlyToggle"
                              AutomationProperties.Name="Fichiers de 1 Go ou plus" ToolTip="Lister les fichiers de 1 Go ou plus">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="11" Margin="0,0,5,0" />
                        <TextBlock Text="≥ 1 Go" />
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"
                   Text="Ctrl/Maj + clic : sélection multiple  ·  Espace : cocher/décocher  ·  ← → : fermer/ouvrir  ·  clic droit : menu" />

        <!-- Explorer card -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <!-- Search header -->
                <Border DockPanel.Dock="Top" Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0" Padding="14,8" Visibility="{Binding IsSearchMode, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Revenir à l'arborescence" Command="{Binding ClearSearchCommand}"
                                AutomationProperties.AutomationId="ClearSearchButton" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource Warning}" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="Résultats de recherche" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding SearchStatus, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                            <Run Text="  ·  la recherche ne modifie jamais la sélection" Foreground="{StaticResource TextFaint}" FontSize="11.5" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <!-- Column headers -->
                <Grid DockPanel.Dock="Top" Margin="14,8,24,6" Visibility="{Binding IsSearchMode, Converter={StaticResource Hidden}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NOM" Style="{StaticResource Label}" Margin="52,0,0,0" />
                    <TextBlock Grid.Column="1" Text="MODIFIÉ LE" Style="{StaticResource Label}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="TAILLE" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}" Visibility="{Binding IsSearchMode, Converter={StaticResource Hidden}}" />

                <Grid>
                    <ListBox x:Name="ExplorerList" ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource RowSelector}"
                             Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ExplorerRowContainer}" SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             Padding="0,4" ContextMenu="{StaticResource RowMenu}" KeyDown="OnListKeyDown" MouseDoubleClick="OnRowDoubleClick"
                             Visibility="{Binding IsSearchMode, Converter={StaticResource Hidden}}" AutomationProperties.AutomationId="ExplorerList" />

                    <ListBox x:Name="SearchList" ItemsSource="{Binding Results}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ExplorerRowContainer}"
                             SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             Padding="0,4" ContextMenu="{StaticResource RowMenu}" KeyDown="OnListKeyDown"
                             Visibility="{Binding IsSearchMode, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="SearchList">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                                <Grid Height="40" Margin="10,0,6,0" AutomationProperties.Name="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Focusable="False" AutomationProperties.AutomationId="RowCheck"
                                              AutomationProperties.Name="{Binding Name}" />
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" />
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource PathText}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource WarningBadge}" Visibility="{Binding IsLarge, Converter={StaticResource Visible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="10" Margin="0,0,4,0" />
                                                <TextBlock Text="Volumineux" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CloudBadge}" Visibility="{Binding IsCloudOnly, Converter={StaticResource Visible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="10" Margin="0,0,4,0" />
                                                <TextBlock Text="Disponible uniquement en ligne" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource SizeCell}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

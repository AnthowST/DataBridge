<UserControl x:Class="DataBridge.App.Views.WifiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBridge.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}" Content="Tout cocher" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Tout décocher" Command="{Binding SelectNoneCommand}" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshWifiButton"
                            AutomationProperties.Name="Actualiser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Actualiser" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Réseaux Wi-Fi enregistrés" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Export des profils WLAN avec l'API Windows et les droits de la session. Les profils sont enregistrés dans Network\WiFi." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="Si Windows autorise la lecture de la clé pour la session, elle est incluse dans le fichier XML exporté (jamais affichée ni écrite dans le journal). Sinon, vous pouvez la récupérer avec les droits administrateur (une seule demande UAC) ; à défaut, le profil est exporté sans clé. Conservez le dossier de sauvegarde en lieu sûr." />
                </DockPanel>
            </Border>

            <!-- 2.1.1: keys refused to the session, recovered on request by ONE elevated worker that only reads these Wi-Fi profiles. -->
            <Border Style="{StaticResource Banner}" Margin="0,10,0,0" Visibility="{Binding ShowRecoverPanel, Converter={StaticResource Visible}}"
                    AutomationProperties.AutomationId="WifiRecoverBanner">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,0,0,0"
                            Command="{Binding RecoverKeysCommand}" AutomationProperties.AutomationId="RecoverWifiKeysButton"
                            AutomationProperties.Name="Récupérer les clés (administrateur)"
                            Visibility="{Binding HasBlockedKeys, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Récupérer les clés (administrateur)" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" Foreground="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding RecoverTitle}" FontWeight="SemiBold" AutomationProperties.AutomationId="WifiRecoverTitle" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                                   Visibility="{Binding HasBlockedKeys, Converter={StaticResource Visible}}"
                                   Text="Windows refuse ces clés avec les droits de la session (par exemple avec un compte utilisateur standard). Une seule demande UAC, avec les identifiants d'un administrateur du PC : seuls ces profils Wi-Fi sont lus avec ces droits, le reste de DataBridge continue sans élévation." />
                        <TextBlock Text="{Binding RecoveryMessage}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding RecoveryMessage, Converter={StaticResource NotEmpty}}"
                                   AutomationProperties.AutomationId="WifiRecoveryMessage" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Loading / unavailable -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding IsLoaded, Converter={StaticResource Hidden}}">
                <TextBlock Text="Détection des profils Wi-Fi…" Foreground="{StaticResource TextMuted}" />
            </Border>
            <Border Style="{StaticResource Banner}" Margin="0,10,0,0" Visibility="{Binding Message, Converter={StaticResource NotEmpty}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Warning}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="WifiMessage" />
                </DockPanel>
            </Border>

            <Border Margin="0,10,0,0" Padding="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="WifiList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WifiItemViewModel}">
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                                              AutomationProperties.AutomationId="WifiCheck" />
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="14" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding Authentication}" /></Border>
                                            <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding Scope}" /></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="KeyIcon" Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource Success}" Margin="0,0,6,0" />
                                        <TextBlock x:Name="KeyText" Text="{Binding KeyText}" FontSize="12" Foreground="{StaticResource Success}" AutomationProperties.AutomationId="WifiKeyStatus" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding KeyBlocked}" Value="True">
                                    <Setter TargetName="KeyIcon" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="KeyIcon" Property="Foreground" Value="{StaticResource Warning}" />
                                    <Setter TargetName="KeyText" Property="Foreground" Value="{StaticResource Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NoKey}" Value="True">
                                    <Setter TargetName="KeyIcon" Property="Text" Value="&#xE946;" />
                                    <Setter TargetName="KeyIcon" Property="Foreground" Value="{StaticResource TextMuted}" />
                                    <Setter TargetName="KeyText" Property="Foreground" Value="{StaticResource TextMuted}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

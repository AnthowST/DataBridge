<Window x:Class="DataBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DataBridge.App.ViewModels"
        xmlns:infra="clr-namespace:DataBridge.App.Infrastructure"
        xmlns:core="clr-namespace:DataBridge.Core;assembly=DataBridge.Core"
        Title="{Binding WindowTitle}"
        Width="1000" Height="750" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundSecondary}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextPrimary}"
        Icon="/Assets/Branding/databridge-icon.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.AutomationId="DataBridgeMainWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= Header -->
        <Border Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource BorderPrimary}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Thin brand accent line -->
                <Border Height="3" VerticalAlignment="Top" Background="{StaticResource BrandGradient}" />
                <Grid Margin="22,14,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo (embedded resource), ratio preserved, high-quality downscaling -->
                    <Image Source="{x:Static infra:BrandAssets.Logo}" Height="30" Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                           Visibility="{Binding Source={x:Static infra:BrandAssets.Logo}, Converter={StaticResource Visible}}"
                           AutomationProperties.AutomationId="HeaderLogo" AutomationProperties.Name="DataBridge" />
                    <TextBlock Text="{x:Static core:AppInfo.Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center"
                               Visibility="{Binding Source={x:Static infra:BrandAssets.Logo}, Converter={StaticResource Hidden}}" />

                    <Border Grid.Column="1" Width="1" Height="32" Background="{StaticResource BorderPrimary}" Margin="18,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{x:Static core:AppInfo.Baseline}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   AutomationProperties.AutomationId="HeaderBaseline" />
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock Margin="0,0,16,0" AutomationProperties.AutomationId="HeaderPc">
                                <Run Text="PC" Foreground="{StaticResource TextTertiary}" /><Run Text="  " /><Run Text="{Binding Profile.MachineName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                            </TextBlock>
                            <TextBlock Margin="0,0,16,0" AutomationProperties.AutomationId="HeaderSession">
                                <Run Text="Session" Foreground="{StaticResource TextTertiary}" /><Run Text="  " /><Run Text="{Binding Profile.UserName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                            </TextBlock>
                            <TextBlock AutomationProperties.AutomationId="HeaderProfile">
                                <Run Text="Profil" Foreground="{StaticResource TextTertiary}" /><Run Text="  " /><Run Text="{Binding Profile.ProfilePath, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Back to the home screen (Sauvegarder / Restaurer): hidden on the home screen, disabled during a copy / restore -->
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Command="{Binding HomeCommand}" VerticalAlignment="Center" Margin="0,0,10,0"
                            Padding="10,6" Visibility="{Binding IsHome, Converter={StaticResource Hidden}}" ToolTip="Revenir au choix Sauvegarder / Restaurer"
                            AutomationProperties.AutomationId="HomeButton" AutomationProperties.Name="Accueil DataBridge">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Accueil DataBridge" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="4" VerticalAlignment="Center" CornerRadius="13" Padding="10,4,11,5" BorderThickness="1"
                            AutomationProperties.AutomationId="ElevationBadge">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessAccent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Profile.IsElevated}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBorder}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource WarningAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Profile.ElevationLabel}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ================================================= Current screen: home (mode choice) or a wizard -->
        <ContentControl Grid.Row="1" Grid.RowSpan="2" Content="{Binding Current}" Focusable="False" />
    </Grid>
</Window>

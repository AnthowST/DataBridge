<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== DataBridge brand
         The whole visual identity lives in this file. Styles (Theme.xaml) and views only reference the
         semantic brushes below, never raw hex values: change a colour here and it propagates everywhere.
         Roles: Navy = structure, titles, strong text · Blue = interaction (selection, navigation, focus,
         primary action, progress) · Teal = sparing positive accents (badges, highlights) ·
         Green = success · Amber = warning · Red = real error · Blue-grey = secondary text and borders.
    -->
    <Color x:Key="DataBridgeNavyColor">#00214D</Color>
    <Color x:Key="DataBridgeTealColor">#00D3C5</Color>
    <Color x:Key="DataBridgeBlueColor">#0074FB</Color>

    <SolidColorBrush x:Key="DataBridgeNavy" Color="{StaticResource DataBridgeNavyColor}" />
    <SolidColorBrush x:Key="DataBridgeTeal" Color="{StaticResource DataBridgeTealColor}" />
    <SolidColorBrush x:Key="DataBridgeBlue" Color="{StaticResource DataBridgeBlueColor}" />

    <!-- Brand gradient, for small precise elements only (accent line, progress fill, hero bar). -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource DataBridgeBlueColor}" Offset="0" />
        <GradientStop Color="{StaticResource DataBridgeTealColor}" Offset="1" />
    </LinearGradientBrush>
    <!-- Mostly blue, with a turquoise touch at the end (progress bars). -->
    <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource DataBridgeBlueColor}" Offset="0" />
        <GradientStop Color="{StaticResource DataBridgeBlueColor}" Offset="0.6" />
        <GradientStop Color="#00B8D9" Offset="1" />
    </LinearGradientBrush>

    <!-- ================================================================== Semantic tokens -->
    <!-- Backgrounds: mostly white, very light blue-greys for breathing room. -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#F5F7FA" />
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#F7F9FB" />
    <SolidColorBrush x:Key="SurfacePrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F3F6FA" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#E8EEF6" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#EBF3FF" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#EEF2F7" />

    <!-- Text: navy-black main text, modern blue-grey secondary text (no washed-out greys). -->
    <SolidColorBrush x:Key="TextStrong" Color="{StaticResource DataBridgeNavyColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="#0B1E3D" />
    <SolidColorBrush x:Key="TextSecondary" Color="#53637C" />
    <SolidColorBrush x:Key="TextTertiary" Color="#7C8BA2" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <!-- Borders: thin blue-greys. -->
    <SolidColorBrush x:Key="BorderPrimary" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C9D3E0" />
    <SolidColorBrush x:Key="BorderHover" Color="#A7B5C9" />

    <!-- Interaction blue. -->
    <SolidColorBrush x:Key="SelectionAccent" Color="{StaticResource DataBridgeBlueColor}" />
    <SolidColorBrush x:Key="SelectionAccentHover" Color="#0063D8" />
    <SolidColorBrush x:Key="SelectionAccentSoft" Color="#EBF3FF" />
    <SolidColorBrush x:Key="SelectionAccentSoftBorder" Color="#B8D5FE" />
    <SolidColorBrush x:Key="PrimaryAction" Color="{StaticResource DataBridgeBlueColor}" />
    <SolidColorBrush x:Key="PrimaryActionHover" Color="#0066E3" />
    <SolidColorBrush x:Key="PrimaryActionPressed" Color="#0055BF" />
    <SolidColorBrush x:Key="InfoAccent" Color="{StaticResource DataBridgeBlueColor}" />
    <SolidColorBrush x:Key="InfoSoft" Color="#EEF5FF" />
    <SolidColorBrush x:Key="InfoBorder" Color="#C7DDFD" />

    <!-- Turquoise: sparing positive accents. TealText is the readable (darker) variant for text on white. -->
    <SolidColorBrush x:Key="TealAccent" Color="{StaticResource DataBridgeTealColor}" />
    <SolidColorBrush x:Key="TealText" Color="#00857C" />
    <SolidColorBrush x:Key="TealSoft" Color="#E2F9F6" />

    <!-- States. -->
    <SolidColorBrush x:Key="SuccessAccent" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessFill" Color="#22A55B" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#EAF7EF" />
    <SolidColorBrush x:Key="SuccessBorder" Color="#BFE5CC" />
    <SolidColorBrush x:Key="WarningAccent" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FFF6E6" />
    <SolidColorBrush x:Key="WarningBorder" Color="#F5D7A1" />
    <SolidColorBrush x:Key="ErrorAccent" Color="#D92D20" />
    <SolidColorBrush x:Key="ErrorSoft" Color="#FEF1F0" />
    <SolidColorBrush x:Key="ErrorBorder" Color="#F6C7C2" />
    <!-- Online-only (cloud) files: calm sky blue, distinct from the interaction blue. -->
    <SolidColorBrush x:Key="CloudAccent" Color="#0369A1" />
    <SolidColorBrush x:Key="CloudSoft" Color="#E6F3FB" />

    <!-- Misc. -->
    <SolidColorBrush x:Key="ProgressTrack" Color="#E6ECF4" />
    <SolidColorBrush x:Key="TooltipBackground" Color="#0B1E3D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4CEDB" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#9AA9BD" />

    <!-- ================================================================== Compatibility aliases
         Historic keys still referenced by the views: they resolve to the DataBridge tokens above. -->
    <SolidColorBrush x:Key="Bg" Color="#F5F7FA" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F7F9FB" />
    <SolidColorBrush x:Key="Hover" Color="#F3F6FA" />
    <SolidColorBrush x:Key="Border" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Text" Color="#0B1E3D" />
    <SolidColorBrush x:Key="TextMuted" Color="#53637C" />
    <SolidColorBrush x:Key="TextFaint" Color="#7C8BA2" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource DataBridgeBlueColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="#0063D8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EBF3FF" />
    <SolidColorBrush x:Key="AccentSoftBorder" Color="#B8D5FE" />
    <SolidColorBrush x:Key="Success" Color="#15803D" />
    <SolidColorBrush x:Key="Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Danger" Color="#D92D20" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEF1F0" />
    <SolidColorBrush x:Key="DangerBorder" Color="#F6C7C2" />
    <SolidColorBrush x:Key="Cloud" Color="#0369A1" />

</ResourceDictionary>
